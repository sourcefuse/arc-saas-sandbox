    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^6.3.0",
    "husky": "^7.0.4",
    "lerna": "^7.3.0",
    "run-s": "^0.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "facades/*"
  ],
  "overrides": {
    "@commitlint/config-lerna-scopes": {
      "lerna": "^7.3.0"
    },
    "postman-request": "2.88.1-postman.49",
    "tar": "^7.5.23",
    "undici": "^6.29.1",
