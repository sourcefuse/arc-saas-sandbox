    "glob@^11.1.0": "^14.0.3",
    "glob@^13.0.6": "^14.0.3",
    "minimatch@^10.0.3": "^11.0.5",
    "minimatch@^10.1.1": "^11.0.5",
    "minimatch@^10.2.1": "^11.0.5",
    "minimatch@^10.2.2": "^11.0.5",
    "minimatch@^10.2.6": "^11.0.5",
